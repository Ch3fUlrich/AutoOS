{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {"type": "path", "style": "diamond", "leading_diamond": "", "trailing_diamond": "", "foreground": "#17212B", "background": "#8BD5CA", "template": " {{ .Path }} ", "properties": {"style": "folder", "home_icon": "Home"}},
        {"type": "root", "style": "plain", "foreground": "#ED8796", "template": "  Administrator"},
        {"type": "executiontime", "style": "plain", "foreground": "#B8C0E0", "template": "  {{ .FormattedMs }}", "properties": {"threshold": 3000, "style": "austin"}}
      ]
    },
    {
      "type": "rprompt",
      "segments": [{"type": "time", "style": "plain", "foreground": "#A5ADCB", "template": "{{ .CurrentDate | date \"15:04\" }}"}]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [{"type": "status", "style": "plain", "foreground": "#A6DA95", "foreground_templates": ["{{ if ne .Code 0 }}#ED8796{{ end }}"], "template": "{{ if ne .Code 0 }}Error {{ .Code }} · {{ end }}❯", "properties": {"always_enabled": true}}]
    }
  ],
  "transient_prompt": {"foreground": "#A6DA95", "template": "❯ "},
  "secondary_prompt": {"foreground": "#A5ADCB", "template": "… "}
}
