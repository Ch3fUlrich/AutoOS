{
  "mcpServers": {
    "omnigraph": {
      "command": "bash",
      "args": [
        "-c",
        "export PATH=\"$HOME/.local/bin:$PATH\"; omnigraph-mcp-autoos"
      ],
      "env": {
        "OMNIGRAPH_BASE_URL": "${OMNIGRAPH_BASE_URL:-http://localhost:8080}",
        "OMNIGRAPH_TOKEN": "${OMNIGRAPH_TOKEN}",
        "OMNIGRAPH_GRAPH_ID": "autoos"
      }
    },
    "autoos-agent": {
      "command": "uv",
      "args": [
        "--quiet",
        "run",
        "--no-project",
        "--with",
        "mcp<2",
        "python",
        "tools/autoos_agent_mcp.py"
      ]
    }
  }
}
