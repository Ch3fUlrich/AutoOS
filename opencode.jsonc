{
  "$schema": "https://opencode.ai/config.json",
  // Repo default: OmniRoute on :20128 (docs/models.md). t1-orchestrator/2/3 and their
  // -clean variants are combos created by configuration/omniroute/apply.*
  // (priority chains: free legs first, allowed paid legs after). The paid
  // overflow legs already cover every provider with money on it: cerebras
  // + sambanova ($10 credit each) as gpt-oss/qwen overflow in t2-worker/t3-driver,
  // cheap-inference ($15 partner pool) between free and paid, deepseek
  // ($13 bulk) as the flash legs. Meta reaches
  // this config through the gateway route spark-1.3-contributor (REVROUTE:
  // policy.reviewers names it); the direct opencode `meta` provider exists only
  // in a user config, and only while META_API_KEY is in the environment — an
  // {env:META_API_KEY} placeholder no shell can fill fails the whole file.
  // No funded provider is missing a leg —
  // verify with `omniroute simulate --combo tierN --explain`.
  // DSMAX (operator 2026-09-27T15:05:54Z) took OpenRouter/DeepSeek off entirely
  // (no credit); T1FREE (L0 2026-09-27T16:00:38Z, every tier keeps a free leg)
  // re-added gemini/gemini-3.8-flash as the free fallback leg of
  // t1-orchestrator and t1-orchestrator-free-only, so t1 is servable again
  // and back as the default. t1-orchestrator-clean and the standalone
  // spark-1.3-contributor combo stay omitted (contributor-only, paid,
  // trains); a sensitive 1M card still fails closed. Role labels (display
  // only — the t1-orchestrator/2/3 ids are a contract and never change):
  // t1-orchestrator = orchestrator, t2-worker = smart-reasoning-128k,
  // t3-driver = cheap-driver-128k. "-clean" excludes every model/plan that
  // trains on prompts — pick it for sensitive data. auto/* stays as a
  // zero-setup bootstrap that always resolves.
  // Effort: `variants` arrays below are rendered from each route's first-leg
  // effort_ladder in catalog/ai-registry.json by tools/sync-ide-models.py
  // (opencode v2.0.16 array form; see docs/models.md "Effort levels").
  // Limits below must match the combo curations: t1-orchestrator serves
  // 1M-declared cards through its gemini fallback while the contributor legs
  // are off. Override per user in
  // ~/.config/opencode/opencode.jsonc. Client key via env
  // AUTOOS_OMNIROUTE_KEY (or configuration/api-keys.yml).
  "model": "omniroute/t1-orchestrator",
  // Serena memory tools are always off: project memory belongs to
  // omnigraph+graphify, never serena memory. MCP tools register as
  // <server>_<tool>, so these six keys disable them globally (an agent-level
  // `tools` glob would override this block).
  "tools": {
    "serena_write_memory": false,
    "serena_read_memory": false,
    "serena_list_memories": false,
    "serena_edit_memory": false,
    "serena_delete_memory": false,
    "serena_rename_memory": false
  },
  // Shell permissions (opencode v2 `permissions`; last match wins): routine
  // git is always allowed so agent sessions can stage and commit. PUSHGATE
  // (operator 2026-10-01): the L0 session merges the take loop and pushes
  // origin/main, so the broad push deny re-opens ONLY for the plain
  // `git push origin main` forms below; every option form (--force / -f /
  // --delete / <src>:<dst>) does not match an allow and stays denied by the
  // `git push *` rule. Merge allows exist only for the L1-backlog take loop.
  // Everything destructive (reset --hard, rebase, branch -D, clean,
  // worktree remove) remains denied. Without these, unmatched shell commands
  // resolve to `ask`, which a non-interactive session cannot answer and the
  // harness reports as permission.rejected.
  "permissions": [
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git rm *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git stash *", "effect": "allow" },
    { "action": "shell", "resource": "git rebase *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git push origin main", "effect": "allow" },
    { "action": "shell", "resource": "git push origin main 2>&1", "effect": "allow" },
    { "action": "shell", "resource": "git push origin main --dry-run", "effect": "allow" },
    { "action": "shell", "resource": "git merge --no-ff L1-backlog/*", "effect": "allow" },
    { "action": "shell", "resource": "git merge --continue", "effect": "allow" },
    { "action": "shell", "resource": "git merge --abort", "effect": "allow" },
    { "action": "shell", "resource": "git fetch origin", "effect": "allow" }
  ],
  // Tier enforcement (hard, runtime-checked): unattended runs select these
  // agents, and the `subagent` permissions below make the depth mandatory —
  // t1-orchestrator may launch t2-worker only, t2-worker may launch
  // t3-reviewer only, t3-reviewer may launch nothing. Last matching
  // rule wins, so the broad deny comes first and the narrow allow after it.
  // NOTE: this binds inside the opencode runtime (CLI/TUI/serve). Harness or
  // API callers that bypass agents must follow the same depth by convention
  // (see .agents/skills/unattended-orchestration/unattended-orchestration.md "Tier enforcement").
  // Depth lives under `experimental`: opencode v2 drops a top-level
  // subagent_depth as an "unsupported legacy setting" and defaults to 1,
  // which made t2-worker answer "Subagent depth limit reached (1)" (2026-09-24).
  "experimental": { "subagent_depth": 2 },
  "agents": {
    "t1-orchestrator": {
      "description": "Long-horizon orchestrator: plans, slices, verifies, never codes directly. May launch t2-worker only.",
      "mode": "all",
      "model": "omniroute/t1-orchestrator#high",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "t2-worker", "effect": "allow" },
        { "action": "task", "resource": "*", "effect": "deny" },
        { "action": "task", "resource": "t2-worker", "effect": "allow" }
      ]
    },
    "t2-worker": {
      "description": "Smart worker: owns one track, reconciles reviews. May launch t3-reviewer only.",
      "mode": "subagent",
      "model": "omniroute/t2-worker",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "t3-reviewer", "effect": "allow" },
        { "action": "task", "resource": "*", "effect": "deny" },
        { "action": "task", "resource": "t3-reviewer", "effect": "allow" }
      ]
    },
    "t3-reviewer": {
      "description": "Cheap reviewer: one focused question, small budget. Reads and runs checks only; never edits, commits or spawns. May not launch subagents.",
      "mode": "subagent",
      "model": "omniroute/t3-driver",
      "permissions": [
        // KEYDENY3b: the spawn gate has two spellings in v2.0.16 — the canonical
        // action `subagent` and the legacy tool name `task` (its rename map is
        // {bash: shell, task: subagent, apply_patch: patch}). `subagent` is the
        // fence; the `task` rule is insurance for a build that still matches the
        // alias, and is not proof — see the `bash` note below, an alias rule can
        // match nothing. A leaf that could spawn would hand the work to a child
        // carrying none of the fences below, key file included.
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "task", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        // v2 calls the shell action `shell`; a `bash` rule matches nothing.
        // The denies below are catalog/agent-harness.json fences
        // (bash_deny_all + bash_deny_leaf), asserted by both suites.
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git merge*", "effect": "deny" },
        { "action": "shell", "resource": "git rebase*", "effect": "deny" },
        { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
        { "action": "shell", "resource": "git branch -D*", "effect": "deny" },
        { "action": "shell", "resource": "git clean*", "effect": "deny" },
        { "action": "shell", "resource": "git worktree remove*", "effect": "deny" },
        { "action": "shell", "resource": "*git *merge*", "effect": "deny" },
        { "action": "shell", "resource": "*git *rebase*", "effect": "deny" },
        { "action": "shell", "resource": "*git *reset --hard*", "effect": "deny" },
        { "action": "shell", "resource": "*git *branch -D*", "effect": "deny" },
        { "action": "shell", "resource": "*git *clean*", "effect": "deny" },
        { "action": "shell", "resource": "*git *worktree remove*", "effect": "deny" },
        { "action": "shell", "resource": "gh *", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf ~*", "effect": "deny" },
        { "action": "shell", "resource": "sudo *", "effect": "deny" },
        { "action": "shell", "resource": "docker compose *", "effect": "deny" },
        { "action": "shell", "resource": "docker rm*", "effect": "deny" },
        { "action": "shell", "resource": "*auth.json*", "effect": "deny" },
        { "action": "shell", "resource": "*api_keys*", "effect": "deny" },
        { "action": "shell", "resource": "*api-keys*", "effect": "deny" },
        { "action": "shell", "resource": "*client.key*", "effect": "deny" },
        { "action": "shell", "resource": "*manage.key*", "effect": "deny" },
        { "action": "shell", "resource": "*.env*", "effect": "deny" },
        { "action": "shell", "resource": "env", "effect": "deny" },
        { "action": "shell", "resource": "env *", "effect": "deny" },
        { "action": "shell", "resource": "printenv*", "effect": "deny" },
        { "action": "shell", "resource": "*.claude.json*", "effect": "deny" },
        { "action": "shell", "resource": "*.config/opencode*", "effect": "deny" },
        { "action": "shell", "resource": "*.local/share/opencode*", "effect": "deny" },
        { "action": "shell", "resource": "set", "effect": "deny" },
        { "action": "shell", "resource": "cat /proc/*", "effect": "deny" },
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        { "action": "shell", "resource": "*git *push*", "effect": "deny" },
        { "action": "shell", "resource": "git commit*", "effect": "deny" },
        { "action": "shell", "resource": "*git *commit*", "effect": "deny" },
        { "action": "shell", "resource": "*git *tag*", "effect": "deny" },
        { "action": "shell", "resource": "*git *update-ref*", "effect": "deny" },
        { "action": "shell", "resource": "*git *stash*", "effect": "deny" },
        { "action": "shell", "resource": "*git *checkout*", "effect": "deny" },
        { "action": "shell", "resource": "*git *switch*", "effect": "deny" },
        { "action": "shell", "resource": "*git *restore*", "effect": "deny" },
        // MCP write tools bypass the edit/write deny: serena is deny-by-default
        // with a read-only allow list; memory-graph and browser-code writes off.
        // KEYDENY3: an MCP rule can only name the tool (v2.0.16 asserts every
        // MCP call as {action:"<server>_<tool>", resources:["*"]}), so nothing
        // on that list can be fenced by path — the allow list therefore excludes
        // every serena tool that can return file bytes: read_file and
        // search_for_pattern directly, find_symbol / find_declaration /
        // find_implementations / find_referencing_symbols through their
        // include_body parameter (serena 1.7.0, tools/symbol_tools.py). What is
        // left returns names or diagnostics, and the leaf still has the
        // path-fenced read tool. catalog/agent-harness.json holds the list.
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "serena_activate_project", "resource": "*", "effect": "allow" },
        { "action": "serena_initial_instructions", "resource": "*", "effect": "allow" },
        { "action": "serena_check_onboarding_performed", "resource": "*", "effect": "allow" },
        { "action": "serena_get_symbols_overview", "resource": "*", "effect": "allow" },
        { "action": "serena_get_diagnostics_for_file", "resource": "*", "effect": "allow" },
        { "action": "serena_list_dir", "resource": "*", "effect": "allow" },
        { "action": "serena_find_file", "resource": "*", "effect": "allow" },
        { "action": "omnigraph_mutate", "resource": "*", "effect": "deny" },
        { "action": "omnigraph_load", "resource": "*", "effect": "deny" },
        { "action": "omnigraph_branches_create", "resource": "*", "effect": "deny" },
        { "action": "omnigraph_branches_merge", "resource": "*", "effect": "deny" },
        { "action": "omnigraph_branches_delete", "resource": "*", "effect": "deny" },
        { "action": "playwright_browser_run_code_unsafe", "resource": "*", "effect": "deny" },
        // KEYDENY3b: an MCP rule can only name the tool (resources is ["*"]), so
        // a server whose tools read by URL or path goes whole, not tool by tool.
        // browser_navigate takes a file:// path — run_code_unsafe was never the
        // only door. context7 fetches remote docs by id/topic for the same reason.
        { "action": "playwright_*", "resource": "*", "effect": "deny" },
        { "action": "context7_*", "resource": "*", "effect": "deny" },
        // A leaf never spawns: the spawner's MCP tools (autoos-agent_spawn and
        // friends, registered for every agent) are off here too.
        { "action": "autoos-agent_*", "resource": "*", "effect": "deny" },
        // The read_deny_all fences (catalog/agent-harness.json) as `read`,
        // `grep`, `glob` and `external_directory` denies: `read: * allow` above
        // left the real key files — configuration/api-keys.yml and the gateway
        // client.key/manage.key — readable by a leaf, and KEYDENY3 closes the
        // two other doors to the same bytes. opencode v2.0.16 asserts a
        // different resource per action, so one deny list means three different
        // matching semantics: `grep`/`glob` are matched against the *search
        // pattern* the leaf passed (it stops a search naming a key file, not a
        // search that happens to hit one), and the searched path is checked only
        // by `external_directory` — which is why a path-scoped deny goes there.
        // Last match wins, so the allows come after, and
        // each one is an exact path suffix: a `shell` allow is matched against
        // the whole command line, so any allow there licenses a real key file
        // paired on the same line (KEYDENY2). There is no shell allow for a key
        // example — a leaf reads the template with the read tool, `cat` stays
        // denied.
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*auth.json", "effect": "deny" },
        { "action": "read", "resource": "*api_keys*", "effect": "deny" },
        { "action": "read", "resource": "*api-keys*", "effect": "deny" },
        { "action": "read", "resource": "*client.key*", "effect": "deny" },
        { "action": "read", "resource": "*manage.key*", "effect": "deny" },
        { "action": "read", "resource": "*.claude.json*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
        { "action": "read", "resource": "*configuration/api-keys.example.yml", "effect": "allow" },
        { "action": "grep", "resource": "*.env", "effect": "deny" },
        { "action": "grep", "resource": "*.env.*", "effect": "deny" },
        { "action": "grep", "resource": "*auth.json", "effect": "deny" },
        { "action": "grep", "resource": "*api_keys*", "effect": "deny" },
        { "action": "grep", "resource": "*api-keys*", "effect": "deny" },
        { "action": "grep", "resource": "*client.key*", "effect": "deny" },
        { "action": "grep", "resource": "*manage.key*", "effect": "deny" },
        { "action": "grep", "resource": "*.claude.json*", "effect": "deny" },
        { "action": "grep", "resource": "*.env.example", "effect": "allow" },
        { "action": "grep", "resource": "*configuration/api-keys.example.yml", "effect": "allow" },
        { "action": "glob", "resource": "*.env", "effect": "deny" },
        { "action": "glob", "resource": "*.env.*", "effect": "deny" },
        { "action": "glob", "resource": "*auth.json", "effect": "deny" },
        { "action": "glob", "resource": "*api_keys*", "effect": "deny" },
        { "action": "glob", "resource": "*api-keys*", "effect": "deny" },
        { "action": "glob", "resource": "*client.key*", "effect": "deny" },
        { "action": "glob", "resource": "*manage.key*", "effect": "deny" },
        { "action": "glob", "resource": "*.claude.json*", "effect": "deny" },
        { "action": "glob", "resource": "*.env.example", "effect": "allow" },
        { "action": "glob", "resource": "*configuration/api-keys.example.yml", "effect": "allow" },
        { "action": "external_directory", "resource": "*.env", "effect": "deny" },
        { "action": "external_directory", "resource": "*.env.*", "effect": "deny" },
        { "action": "external_directory", "resource": "*auth.json", "effect": "deny" },
        { "action": "external_directory", "resource": "*api_keys*", "effect": "deny" },
        { "action": "external_directory", "resource": "*api-keys*", "effect": "deny" },
        { "action": "external_directory", "resource": "*client.key*", "effect": "deny" },
        { "action": "external_directory", "resource": "*manage.key*", "effect": "deny" },
        { "action": "external_directory", "resource": "*.claude.json*", "effect": "deny" }
      ]
    }
  },
  "providers": {
    "omniroute": {
      "name": "AutoOS OmniRoute gateway",
      "env": ["AUTOOS_OMNIROUTE_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1"
      },
      // Model ids, display names and limits come from catalog/ide-models.json
      // (rendered from catalog/ai-registry.json - do not edit): edit the
      // registry, then run `python3 tools/sync-ide-models.py`. Lines between the markers are
      // regenerated; hand entries above START / below END are kept.
      "models": {
        // Direct provider passthrough (hand entries, kept outside the managed
        // region). Live on the gateway since 2026-09-30: `vertex` connection
        // registered from the vertex_ai key; ids match `omniroute models vertex`.
        // Spawn agents with model "omniroute/vertex-flash" etc.
        "vertex-flash": {
          "modelID": "vertex/gemini-3-flash-preview",
          "name": "vertex-flash — direct Gemini 3 Flash (Vertex AI, no combo)",
          "limit": { "context": 1048576, "output": 65536 }
        },
        "vertex-flash-lite": {
          "modelID": "vertex/gemini-3.1-flash-lite",
          "name": "vertex-flash-lite — cheapest direct Gemini (Vertex AI)",
          "limit": { "context": 1048576, "output": 65536 }
        },
        "vertex-pro": {
          "modelID": "vertex/gemini-3.1-pro-preview",
          "name": "vertex-pro - direct Gemini 3.1 Pro (Vertex AI)",
          "limit": { "context": 1048576, "output": 65536 }
        },
        "vertex-3.8-flash": {
          "modelID": "vertex/gemini-3.8-flash",
          "name": "vertex-3.8-flash - direct Gemini 3.8 Flash (Vertex AI, no combo)",
          "limit": { "context": 1048576, "output": 65536 }
        },
        "gemini-2.5-flash": {
          "modelID": "gemini/gemini-2.5-flash",
          "name": "gemini-2.5-flash - AI Studio direct (1M ctx, no combo)",
          "limit": { "context": 1048576, "output": 65536 }
        },
        // AUTOOS-MANAGED-START omniroute
        "t1-orchestrator": {
          "modelID": "t1-orchestrator",
          "name": "t1 orchestrator-1M -- gemini free -> vertex credit -> meta_api/deepseek paid",
          "limit": { "context": 1000000, "output": 32768 },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "t1-orchestrator-paid": {
          "modelID": "t1-orchestrator-paid",
          "name": "t1 orchestrator-1M — meta_api paid",
          "limit": { "context": 1000000, "output": 32768 },
          "variants": [
            { "id": "minimal", "settings": { "reasoningEffort": "minimal" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "t1-orchestrator-free-only": {
          "modelID": "t1-orchestrator-free-only",
          "name": "t1 orchestrator-1M -- zero spend (gemini + free_ai 1M free legs only)",
          "limit": { "context": 1000000, "output": 32768 },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "t2-worker": {
          "modelID": "t2-worker",
          "name": "t2 smart-reasoning-128k — ≤128k ctx (free-first)",
          "limit": { "context": 128000, "output": 32768 },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "t2-worker-clean": {
          "modelID": "t2-worker-clean",
          "name": "t2 smart-reasoning-1M — no training (sensitive data)",
          "limit": { "context": 1048576, "output": 32768 },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "t2-worker-free-only": {
          "modelID": "t2-worker-free-only",
          "name": "t2 smart-reasoning-128k — zero spend (free legs only)",
          "limit": { "context": 128000, "output": 32768 },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "t2-orchestrator": {
          "modelID": "t2-orchestrator",
          "name": "t2 orchestrator-1M — small-scope orchestration",
          "limit": { "context": 1048576, "output": 32768 },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "t3-driver": {
          "modelID": "t3-driver",
          "name": "t3 cheap-driver-128k — ≤128k ctx (cheapest)",
          "limit": { "context": 128000, "output": 16384 },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
