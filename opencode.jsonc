  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "serena-agent==1.7.0",
          "serena",
          "start-mcp-server",
          "--open-web-dashboard",
          "false",
          "--enable-gui-log-window",
          "false"
        ]
      },
      "graphify": {
        "type": "local",
        "command": [
          "uv",
          "--quiet",
          "run",
          "--with",
          "graphifyy[mcp]==0.9.63",
          "python",
          "-m",
          "graphify.serve",
          "graphify-out/graph.json"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.81"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp@4.1.1"
        ]
      },
      "omnigraph": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modernrelay/omnigraph-mcp@0.8.0"
        ],
        "environment": {
          "OMNIGRAPH_BASE_URL": "http://localhost:8080",
          "OMNIGRAPH_GRAPH_ID": "autoos"
        }
      },
      // The agent spawner (tools/autoos_agent_mcp.py): spawn/status/result/cancel
      // for every client; depth-policed through AUTOOS_AGENT_DEPTH.
      "autoos-agent": {
        "type": "local",
        "command": [
          "uv",
          "--quiet",
          "run",
          "--no-project",
          "--with",
          "mcp<2",
          "python",
          "tools/autoos_agent_mcp.py"
        ]
      }
    }
  }
}
