{
  "$schema": "https://opencode.ai/config.json",
  // Repo default: OmniRoute on :20128 (docs/models.md). tier1/2/3 and their
  // -clean variants are combos created by configuration/omniroute/apply.*
  // (priority chains: free legs first, allowed paid legs after). The paid
  // overflow legs already cover every provider with money on it: cerebras
  // + sambanova ($10 credit each) as gpt-oss/qwen overflow in tier2/tier3,
  // deepseek ($13 bulk) + openrouter ($1, last resort) as flash legs,
  // cheap-inference ($15 partner pool) between free and paid, meta ($10)
  // where the spark family bills. No funded provider is missing a leg —
  // verify with `omniroute simulate --combo tierN --explain`.
  // spark-1.3-contributor is the same tier1 legs as a standalone pinned
  // single-model combo (zen free → openrouter paid), for callers that want
  // the spark family directly. Role labels (display only — the tier1/2/3
  // ids are a contract and never change):
  // tier1 = orchestrator-1M, tier2 = smart-reasoning-128k,
  // tier3 = cheap-driver-128k. "-clean" excludes every model/plan that
  // trains on prompts — pick it for sensitive data. auto/* stays as a
  // zero-setup bootstrap that always resolves.
  // Effort/variants note (measured 2026-09-22): opencode builds a model's
  // variant list from the PROVIDER CATALOG's supportedThinkingEfforts, not
  // from config — a hand-declared "variants" block does not register and
  // makes the provider unresolvable. On OmniRoute gateway combos that
  // metadata is absent, so `omniroute/tier1#xhigh` answers "Variant
  // unavailable" while `#low/#medium/#high` resolve client-side.
  // RULE: for the FULL effort ladder use the direct provider model
  // (`openrouter/meta/muse-spark-1.3-contributor#minimal` … `#xhigh`,
  // ack-proven) — openrouter advertises minimal/low/medium/high/xhigh for
  // spark (no `max`; that is Zen-native only). Use the gateway combos for
  // fallback routing, the direct model for effort control.
  // NEW: OpenRouter provider added at `openrouter/muse-spark-1.3-contributor`
  // gives direct access to the full variant ladder (minimal/low/medium/high/xhigh).
  // Requires OPENROUTER_API_KEY in env or configuration/api-keys.yml.
  // Limits below must match the combo curations: tier1 is 1M-context only;
  // anything smaller belongs in tier2. Override per user in
  // ~/.config/opencode/opencode.jsonc. Client key via env
  // AUTOOS_OMNIROUTE_KEY (or configuration/api-keys.yml).
  "model": "omniroute/tier1",
  // Serena memory tools are always off: project memory belongs to
  // omnigraph+graphify, never serena memory. MCP tools register as
  // <server>_<tool>, so these six keys disable them globally (an agent-level
  // `tools` glob would override this block).
  "tools": {
    "serena_write_memory": false,
    "serena_read_memory": false,
    "serena_list_memories": false,
    "serena_edit_memory": false,
    "serena_delete_memory": false,
    "serena_rename_memory": false
  },
  // Shell permissions (opencode v2 `permissions`; last match wins): routine
  // git is always allowed so agent sessions can stage and commit; pushes
  // stay denied (operator pushes by hand). Without these, unmatched shell
  // commands resolve to `ask`, which a non-interactive session cannot
  // answer and the harness reports as permission.rejected.
  "permissions": [
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" }
  ],
  // Tier enforcement (hard, runtime-checked): unattended runs select these
  // agents, and the `subagent` permissions below make the depth mandatory —
  // tier1-orchestrator may launch tier2-worker only, tier2-worker may launch
  // tier3-reviewer only, tier3-reviewer may launch nothing. Last matching
  // rule wins, so the broad deny comes first and the narrow allow after it.
  // NOTE: this binds inside the opencode runtime (CLI/TUI/serve). Harness or
  // API callers that bypass agents must follow the same depth by convention
  // (see docs/unattended-orchestration.md "Tier enforcement").
  "subagent_depth": 2,
  "agents": {
    "tier1-orchestrator": {
      "description": "Long-horizon orchestrator: plans, slices, verifies, never codes directly. May launch tier2-worker only.",
      "mode": "all",
      "model": "omniroute/tier1#high",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "tier2-worker", "effect": "allow" }
      ]
    },
    "tier2-worker": {
      "description": "Smart worker: owns one track, reconciles reviews. May launch tier3-reviewer only.",
      "mode": "subagent",
      "model": "omniroute/tier2",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "tier3-reviewer", "effect": "allow" }
      ]
    },
    "tier3-reviewer": {
      "description": "Cheap reviewer: one focused question, small budget. Reads and runs checks only; never edits, commits or spawns. May not launch subagents.",
      "mode": "subagent",
      "model": "omniroute/tier3",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "bash", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "providers": {
    "omniroute": {
      "name": "AutoOS OmniRoute gateway",
      "env": ["AUTOOS_OMNIROUTE_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1"
      },
      "models": {
        "tier1": {
          "modelID": "tier1",
          "name": "tier1 orchestrator-1M — 1M ctx (free-first)",
          "limit": { "context": 1000000, "output": 32768 }
        },
        "tier1-clean": {
          "modelID": "tier1-clean",
          "name": "tier1 orchestrator-1M — no training (sensitive data)",
          "limit": { "context": 1000000, "output": 32768 }
        },
        "tier2": {
          "modelID": "tier2",
          "name": "tier2 smart-reasoning-128k — ≤128k ctx (free-first)",
          "limit": { "context": 131072, "output": 32768 }
        },
        "tier2-clean": {
          "modelID": "tier2-clean",
          "name": "tier2 smart-reasoning-128k — no training (sensitive data)",
          "limit": { "context": 131072, "output": 32768 }
        },
        "tier3": {
          "modelID": "tier3",
          "name": "tier3 cheap-driver-128k — ≤128k ctx (cheapest)",
          "limit": { "context": 131072, "output": 16384 }
        },
        "tier3-clean": {
          "modelID": "tier3-clean",
          "name": "tier3 cheap-driver-128k — no training (sensitive data)",
          "limit": { "context": 131072, "output": 16384 }
        },
        "spark-1.3-contributor": {
          "modelID": "spark-1.3-contributor",
          "name": "spark-1.3-contributor — zen free → openrouter paid (1M)",
          "limit": { "context": 1000000, "output": 32768 }
        },
        "rag": {
          "modelID": "rag",
          "name": "rag cohere RAG — 128k ctx (trial keys)",
          "limit": { "context": 131072, "output": 16384 }
        },
        "gemini-3.8-flash": {
          "modelID": "gemini-3.8-flash",
          "name": "gemini-3.8-flash — gemini free → paid",
          "limit": { "context": 131072, "output": 32768 }
        },
        "deepseek-v4.1-flash": {
          "modelID": "deepseek-v4.1-flash",
          "name": "deepseek-v4.1-flash — paid cheapest-first",
          "limit": { "context": 131072, "output": 32768 }
        },
        "tier2-credit": {
          "modelID": "tier2-credit",
          "name": "tier2-credit smart (credit-burn)",
          "limit": { "context": 131072, "output": 32768 }
        },
        "tier3-credit": {
          "modelID": "tier3-credit",
          "name": "tier3-credit driver (credit-burn)",
          "limit": { "context": 131072, "output": 32768 }
        },
        "auto/smart": {
          "modelID": "auto/smart",
          "name": "bootstrap: auto smart (no combo needed)",
          "limit": { "context": 131072, "output": 32768 }
        },
        "auto": {
          "modelID": "auto",
          "name": "bootstrap: auto balanced",
          "limit": { "context": 131072, "output": 32768 }
        },
        "auto/cheap": {
          "modelID": "auto/cheap",
          "name": "bootstrap: auto cheapest",
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    },
    "openrouter": {
      "name": "OpenRouter (direct — full variant ladder for spark)",
      "env": ["OPENROUTER_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "modelID": "meta/muse-spark-1.3-contributor",
          "name": "Muse Spark 1.3 Contributor — 1M ctx, full effort ladder",
          "limit": { "context": 1048576, "output": 131072 }
        }
      }
    },
    "litellm": {
      "name": "AutoOS LiteLLM router (manual fallback)",
      "env": ["LITELLM_MASTER_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:4000/v1"
      },
      "models": {
        "tier1": {
          "modelID": "tier1",
          "name": "tier1 orchestrator (free-first)"
        },
        "tier1-paid": {
          "modelID": "tier1-paid",
          "name": "tier1-paid orchestrator (meta direct first)"
        },
        "tier2": {
          "modelID": "tier2",
          "name": "tier2 smart (free-first)"
        },
        "tier2-paid": {
          "modelID": "tier2-paid",
          "name": "tier2-paid smart (paid)"
        },
        "tier3": {
          "modelID": "tier3",
          "name": "tier3 codegen driver (free-first)"
        },
        "tier3-paid": {
          "modelID": "tier3-paid",
          "name": "tier3-paid driver (paid)"
        },
        "rag": {
          "modelID": "rag",
          "name": "rag cohere RAG (litellm fallback)"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "serena-agent==1.7.0",
          "serena",
          "start-mcp-server",
          "--open-web-dashboard",
          "false",
          "--enable-gui-log-window",
          "false"
        ]
      },
      "graphify": {
        "type": "local",
        "command": [
          "uv",
          "--quiet",
          "run",
          "--with",
          "graphifyy[mcp]==0.9.63",
          "python",
          "-m",
          "graphify.serve",
          "graphify-out/graph.json"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.81"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp@4.1.1"
        ]
      },
      "omnigraph": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modernrelay/omnigraph-mcp@0.8.0"
        ],
        "environment": {
          "OMNIGRAPH_BASE_URL": "http://localhost:8080",
          "OMNIGRAPH_GRAPH_ID": "autoos"
        }
      }
    }
  }
}
