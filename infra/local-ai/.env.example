# .env — local AI & coding stack (docker-compose.yml)
# Copy to .env and fill in your real values.
# Tracked file only ever holds placeholders.

# Base directory for app data (models, databases, configs).
# Linux/macOS: ~/apps    Windows: C:/Apps
APPS_ROOT=/home/you/apps

# Workspace base for OpenHands agent (where it checks out repos).
WORKSPACE_BASE=/home/you/workspace

# Ollama API port (host side).
OLLAMA_API_PORT=11434

# Ollama concurrency settings.
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=3

# LiteLLM proxy port.
LITELLM_PORT=4000

# LiteLLM master key (for proxy auth). Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=generate-with-openssl-rand-hex-32

# Perplexity API key for LiteLLM proxy (required for sonar* models).
# Get from: https://www.perplexity.ai/settings/api
# Optional — leave empty if not using Perplexity models.
PERPLEXITY_API_KEY=optional-set-if-using-sonar-models

# Open WebUI port.
OPENWEBUI_HTTP_PORT=3131

# Open WebUI secret key. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=generate-with-openssl-rand-hex-32

# Open WebUI auth (set to false to disable login).
WEBUI_AUTH=true

# Optional: OpenAI-compatible API base URL (default: LiteLLM proxy).
OPENAI_API_BASE_URL=http://litellm-proxy:4000/v1

# Optional: OpenAI API key (or use LiteLLM's master key).
OPENAI_API_KEY=sk-proxy-1234

# Optional: Anthropic API key (for OpenHands / direct API use).
# Get from: https://console.anthropic.com/settings/keys
# Optional — leave empty if not using Anthropic models directly.
ANTHROPIC_API_KEY=optional-set-if-using-anthropic-directly