# .env.server.example — placeholders only, safe to commit.
#
# Copy to .env.server and fill in:
#   cp .env.server.example .env.server
#
# Server role — the central memory stack (docker-compose.server.yml). Load the
# shared file first, then this one:
#   docker compose --env-file .env.shared --env-file .env.server -f docker-compose.server.yml up -d
#
# Never commit the real .env.server (it is gitignored).

# ─── MinIO — S3 object store backing Omnigraph ───────────────────────────────
# Root credentials for the MinIO server. Both are required (compose fails with
# ":?" if unset). Pick a strong password; anything >= 8 chars.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password

# Host ports for the MinIO API and web console. Both bind to 127.0.0.1 only.
# Override if 9000/9001 are taken on this host.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Ollama embedding host ───────────────────────────────────────────────────
# The name the omnigraph-server container resolves the LAN Ollama host by
# (extra_hosts mapping), and its IP. Both are required (compose ":?").
# The name must match the host used in cluster/cluster.yaml's embedding URL.
# (example.com TEST-NET-2 address below — replace with your real Ollama host IP.)
OLLAMA_HOST_NAME=ollama.example.internal
OLLAMA_HOST_IP=198.51.100.20

# ─── Observability profile (optional; only with --profile observability) ──────
# Datadog API key + site. Leave unset unless you run the datadog-agent service.
# DD_API_KEY=
# DD_SITE=datadoghq.com
