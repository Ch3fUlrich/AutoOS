# site.env — site-specific hosts and paths. Never committed.
#
# Copy to the USER scope and fill in your real values:
#   mkdir -p ~/.config/autoos && cp site.env.example ~/.config/autoos/site.env
#
# Lookup order (first hit wins):
#   1. the process environment
#   2. ~/.config/autoos/site.env   (compose: an extra `--env-file ~/.config/autoos/site.env`)
#   3. the defaults written in the compose files / scripts
#
# The tracked tree only ever holds the placeholders below.

# Central Omnigraph API and MinIO console (public URLs behind your reverse proxy).
OMNIGRAPH_URL=https://omnigraph.example.org
MINIO_CONSOLE_URL=https://omnigraph-minio.example.org

# The server VM that runs the central memory stack (docs call it coding.example.internal).
CODING_HOST=coding.example.internal

# Name the omnigraph-server container resolves the Ollama embedding host by
# (docker-compose.server.yml -> extra_hosts). Must match the host in cluster/cluster.yaml's
# embedding base_url. Required by docker-compose.server.yml.
OLLAMA_HOST_NAME=ollama.example.internal
# The Ollama host's LAN IP usually lives in .env.server; set it here only if it does not.
# OLLAMA_HOST_IP=192.0.2.10

# Directory of the CENTRAL compose project in your private site repository
# (scripts/dedup-graph.py reads its .env and docker-compose.yml from here).
OMNIGRAPH_SITE_DIR=~/site-repo/mcp-servers
