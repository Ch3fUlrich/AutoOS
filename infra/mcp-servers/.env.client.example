# .env.client.example — placeholders only, safe to commit.
#
# Copy to .env.client and fill in:
#   cp .env.client.example .env.client
#
# Client role — the MCP tools a developer machine runs for its coding agent
# (docker-compose.client.yml). Load the shared file first, then this one:
#   docker compose --env-file .env.shared --env-file .env.client -f docker-compose.client.yml up -d
#
# Never commit the real .env.client (it is gitignored).

# ─── Serena — LSP code navigation ────────────────────────────────────────────
# Absolute path to your repos root. It is bind-mounted at the SAME path inside
# the container so the project paths your agent sends resolve. Required
# (compose fails with ":?" if unset). Use your real checkout root.
CODE_ROOT=/home/you/code

# ─── Offline local memory (only with --profile offline) ──────────────────────
# Credentials for the client's own throwaway MinIO. LOCAL_MINIO_USER defaults to
# "omnigraph"; LOCAL_MINIO_PASSWORD is required whenever the offline profile is
# up (compose ":?"). Not needed for the online (client-only) path.
LOCAL_MINIO_USER=omnigraph
LOCAL_MINIO_PASSWORD=replace-with-a-strong-local-password

# ─── Observability profile (optional; only with --profile observability) ──────
# Sentry MCP. Generate a token at https://<sentry>/settings/alerts-api-tokens/.
# SENTRY_ACCESS_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Datadog MCP.
# DD_API_KEY=
# DD_APP_KEY=
# DD_SITE=datadoghq.com
