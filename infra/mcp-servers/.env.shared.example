# .env.shared.example — placeholders only, safe to commit.
#
# Copy to .env.shared and fill in:
#   cp .env.shared.example .env.shared
#
# These keys are shared by BOTH the server stack (docker-compose.server.yml)
# and the client stack (docker-compose.client.yml). Load it first in both:
#   docker compose --env-file .env.shared --env-file .env.server -f docker-compose.server.yml up -d
#   docker compose --env-file .env.shared --env-file .env.client -f docker-compose.client.yml up -d
#
# Never commit the real .env.shared (it is gitignored).

# Bearer token for the central/local Omnigraph server. Required — compose fails
# with ":?" if it is unset. Generate one and do not reuse it across environments:
#   openssl rand -hex 32
OMNIGRAPH_TOKEN=replace-with-openssl-rand-hex-32-output

# S3 bucket that backs Omnigraph (MinIO). Defaults to "omnigraph" if unset.
S3_BUCKET=omnigraph

# Region the AWS SDK selects for the S3 client. Only matters against real AWS;
# against MinIO it is ignored. Defaults to "us-east-1".
# AWS_REGION=us-east-1

# Key the Omnigraph embedding provider sends to Ollama. Ollama ignores it; this
# is only a non-empty placeholder so the client picks the OpenAI-compatible
# path. Defaults to "ollama".
# OLLAMA_DUMMY_KEY=ollama
