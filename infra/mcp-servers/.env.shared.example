# .env.shared.example — placeholders only, safe to commit.
#
# Copy to .env.shared and fill in:
#   cp .env.shared.example .env.shared
#
# These keys are shared by BOTH the server stack (docker-compose.server.yml)
# and the client stack (docker-compose.client.yml). Load it first in both:
#   docker compose --env-file .env.shared --env-file .env.server -f docker-compose.server.yml up -d
#   docker compose --env-file .env.shared --env-file .env.client -f docker-compose.client.yml up -d
#
# Never commit the real .env.shared (it is gitignored).

# Bearer token for the central/local Omnigraph server. Required — compose fails
# with ":?" if it is unset. Generate one and do not reuse it across environments:
#   openssl rand -hex 32
OMNIGRAPH_TOKEN=replace-with-openssl-rand-hex-32-output

# S3 bucket that backs Omnigraph (MinIO); defaults to "omnigraph-013" if unset;
# an Omnigraph 0.13 server must NEVER share a bucket with 0.8.x data (its on-disk
# format is incompatible), so keep a different name from any bucket a 0.8.1
# server wrote to.
S3_BUCKET=omnigraph-013

# Region the AWS SDK selects for the S3 client. Only matters against real AWS;
# against MinIO it is ignored. Defaults to "us-east-1".
# AWS_REGION=us-east-1

# Key the Omnigraph embedding provider sends to Ollama. Ollama ignores it; this
# is only a non-empty placeholder so the client picks the OpenAI-compatible
# path. Defaults to "ollama".
# OLLAMA_DUMMY_KEY=ollama

# MinIO / mc image
#
# Server stack. Replace the placeholder registry host with your internal mirror of the
# SAME digest — compose refuses to start while these are unset (the ":?" form), because
# the upstream `latest` tags are not pullable on a provisioned target host and a floating
# tag is never traceable to the bytes that wrote the store. Never pull `latest`.
# mc ships inside the mirrored minio image (/usr/bin/mc): there is no separate mc image,
# so the two variables hold one reference — which is why minio-init overrides its
# entrypoint. registry.example.invalid is a reserved placeholder host, not a real registry.
OMNIGRAPH_MINIO_IMAGE=registry.example.invalid/mirror/minio@sha256:52dfd5c0bbd38d3219f2058c7af216d9f9a27a994b7b5baad09bbd38866015ff
OMNIGRAPH_MC_IMAGE=registry.example.invalid/mirror/minio@sha256:52dfd5c0bbd38d3219f2058c7af216d9f9a27a994b7b5baad09bbd38866015ff

# Second stack beside a live one
#
# Server stack. The default prefix is EMPTY, and must stay so: the operator scripts
# address these containers BY NAME (apply-cluster.sh runs `docker stop
# omnigraph-server`, dedup-graph.py filters `name=omnigraph-minio`). Set a prefix only to
# run a second stack on a host that already has one up. Service names — the DNS names on
# the network, e.g. http://omnigraph-server:8080 — never take the prefix.
# OMNIGRAPH_CONTAINER_PREFIX=

# Host ports published on 127.0.0.1 (server stack). The container-side ports stay
# 8080 / 8090; set these when the port is taken, or for a second stack. The MinIO
# ports have their own knobs (MINIO_API_PORT / MINIO_CONSOLE_PORT) in .env.server.
# OMNIGRAPH_PORT=8080
# OMNIGRAPH_VIEWER_PORT=8090
