            "workstation",
            "ai-coding"
          ],
          "verify": "oh-my-posh --version",
          "homepage": "https://ohmyposh.dev/",
          "notes": "Installs a calm everyday prompt, completion/history helpers and file icons. The coding theme remains available.",
