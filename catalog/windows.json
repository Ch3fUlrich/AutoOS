  ],
  "prompts": {
    "omnigraph_url": {
      "question": "Omnigraph remote server URL (blank = local Docker stack on :8080)",
      "default": "",
      "validate": "url_or_empty",
      "help": "If you run a shared Omnigraph server, give its base URL here and the MCP config will point at it instead of localhost."
    },
    "herdr_source": {
      "question": "Herdr install source",
      "default": "npm:herdr",
      "help": "Accepts npm:<package>, git:<url> or a direct download URL. Herdr is not in winget, so AutoOS needs to be told where it lives."
    }
  },
  "windhawk_mods": [
    {
      "id": "explorer-details-better-file-sizes",
      "name": "Better file sizes in Explorer details",
      "settings": {}
    },
    {
      "id": "taskbar-clock-customization",
      "name": "Taskbar Clock Customization",
      "settings": {
        "TopLine": "%date%  %time%",
        "BottomLine": "💻%cpu%    |    %gpu% 🎞️  %newline%🧠%ram%    | %total_speed%"
      }
    }
  ]
}
