{
  "$schema": "./schema.json",
  "platform": "windows",
  "profiles": {
    "workstation": "Full development workstation — everything below that fits the hardware.",
    "ai-coding": "Coding and AI tooling only, plus the terminal it runs in.",
    "light": "Minimal remote-access box — Claude Code, Tailscale and Herdr only.",
    "custom": "Start with nothing ticked and choose by hand."
  },
  "categories": [
    {
      "id": "terminal",
      "name": "Terminal & Shell",
      "description": "The shell you will spend the rest of the setup looking at.",
      "components": [
        {
          "id": "windows-terminal",
          "name": "Windows Terminal",
          "description": "Tabbed terminal with true-colour support",
          "provider": "winget",
          "package": "Microsoft.WindowsTerminal",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "homepage": "https://learn.microsoft.com/windows/terminal/"
        },
        {
          "id": "powershell7",
          "name": "PowerShell 7",
          "description": "Modern cross-platform PowerShell",
          "provider": "winget",
          "package": "Microsoft.PowerShell",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "verify": "pwsh --version",
          "homepage": "https://learn.microsoft.com/powershell/"
        },
        {
          "id": "oh-my-posh",
          "name": "Oh My Posh",
          "description": "Prompt theme engine for PowerShell",
          "provider": "winget",
          "package": "JanDeDobbeleer.OhMyPosh",
          "requires": [
            "powershell7",
            "nerd-font"
          ],
          "postInstall": "Install-AutoOSPoshTheme",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "verify": "oh-my-posh --version",
          "homepage": "https://ohmyposh.dev/"
        },
        {
          "id": "nerd-font",
          "name": "Meslo Nerd Font",
          "description": "Patched font with prompt glyphs and icons",
          "provider": "script",
          "package": "meslo-nerd-font",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "postInstall": "Install-AutoOSNerdFont",
          "notes": "No winget package exists for Meslo; downloaded from the ryanoasis/nerd-fonts release and installed per-user.",
          "homepage": "https://www.nerdfonts.com/"
        }
      ]
    },
    {
      "id": "ui-design",
      "name": "UI & Desktop Design",
      "description": "Explorer, taskbar and window-manager customisation.",
      "components": [
        {
          "id": "windhawk",
          "name": "Windhawk",
          "description": "Mod platform for Explorer and the taskbar",
          "provider": "winget",
          "package": "RamenSoftware.Windhawk",
          "postInstall": "Install-AutoOSWindhawkMods",
          "profiles": [
            "workstation"
          ],
          "notes": "Seeds settings for the Better file sizes and Taskbar Clock mods; the mods themselves are enabled once from the Windhawk UI.",
          "homepage": "https://windhawk.net/"
        },
        {
          "id": "powertoys",
          "name": "PowerToys",
          "description": "FancyZones, PowerRename, Run and friends",
          "provider": "winget",
          "package": "Microsoft.PowerToys",
          "profiles": [
            "workstation"
          ],
          "homepage": "https://learn.microsoft.com/windows/powertoys/"
        },
        {
          "id": "treesize",
          "name": "TreeSize Free",
          "description": "Find what is eating the disk",
          "provider": "winget",
          "package": "JAMSoftware.TreeSize.Free",
          "profiles": [
            "workstation"
          ],
          "homepage": "https://www.jam-software.com/treesize_free"
        }
      ]
    },
    {
      "id": "ai-coding",
      "name": "Coding & AI",
      "description": "Editors, agents and the runtimes they need.",
      "components": [
        {
          "id": "git",
          "name": "Git",
          "description": "Version control",
          "provider": "winget",
          "package": "Git.Git",
          "postInstall": "Add-AutoOSGitToPath",
          "profiles": [
            "workstation",
            "ai-coding",
            "light"
          ],
          "verify": "git --version",
          "homepage": "https://git-scm.com/"
        },
        {
          "id": "nodejs",
          "name": "Node.js LTS",
          "description": "JavaScript runtime — required by Claude Code",
          "provider": "winget",
          "package": "OpenJS.NodeJS.LTS",
          "profiles": [
            "workstation",
            "ai-coding",
            "light"
          ],
          "verify": "node --version",
          "homepage": "https://nodejs.org/"
        },
        {
          "id": "claude-code",
          "name": "Claude Code CLI",
          "description": "Anthropic's terminal coding agent",
          "provider": "npm",
          "package": "@anthropic-ai/claude-code",
          "requires": [
            "nodejs"
          ],
          "profiles": [
            "workstation",
            "ai-coding",
            "light"
          ],
          "verify": "claude --version",
          "homepage": "https://docs.anthropic.com/en/docs/claude-code"
        },
        {
          "id": "claude-desktop",
          "name": "Claude Desktop",
          "description": "Claude desktop application",
          "provider": "winget",
          "package": "Anthropic.Claude",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "homepage": "https://claude.ai/download"
        },
        {
          "id": "handy",
          "name": "Handy",
          "description": "Offline speech-to-text — dictate instead of typing",
          "provider": "winget",
          "package": "cjpais.Handy",
          "homepage": "https://github.com/cjpais/Handy",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "notes": "Needs a microphone; runs fully offline, nothing is sent to a server."
        },
        {
          "id": "antigravity",
          "name": "Antigravity",
          "description": "Google's agent-first IDE",
          "provider": "winget",
          "package": "Google.Antigravity",
          "postInstall": "Set-AutoOSAntigravityMcp",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "homepage": "https://antigravity.google/"
        },
        {
          "id": "vscode",
          "name": "Visual Studio Code",
          "description": "Editor",
          "provider": "winget",
          "package": "Microsoft.VisualStudioCode",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "verify": "code --version",
          "homepage": "https://code.visualstudio.com/"
        },
        {
          "id": "docker",
          "name": "Docker Desktop",
          "description": "Containers — backs the local MCP memory stack",
          "provider": "winget",
          "package": "Docker.DockerDesktop",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "notes": "Requires virtualisation enabled in BIOS and a reboot after install.",
          "verify": "docker --version",
          "homepage": "https://www.docker.com/products/docker-desktop/"
        },
        {
          "id": "herdr",
          "name": "Herdr",
          "description": "Persistent, resumable AI sessions",
          "provider": "script",
          "package": "herdr",
          "requires": [
            "nodejs"
          ],
          "profiles": [
            "workstation",
            "ai-coding",
            "light"
          ],
          "prompt": "herdr_source",
          "verify": "herdr --version",
          "homepage": "https://www.npmjs.com/package/herdr"
        },
        {
          "id": "agent-skills",
          "name": "agent-skills + MCP servers",
          "description": "Clone Ch3fUlrich/agent-skills and wire up the MCP stack",
          "provider": "custom",
          "package": "agent-skills",
          "requires": [
            "git",
            "nodejs"
          ],
          "postInstall": "Install-AutoOSAgentSkills",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "prompt": "omnigraph_url",
          "homepage": "https://github.com/Ch3fUlrich/agent-skills"
        }
      ]
    },
