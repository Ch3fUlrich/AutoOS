        {
          "id": "windows-terminal",
          "name": "Windows Terminal",
          "description": "Tabbed terminal with true-colour support",
          "provider": "winget",
          "package": "Microsoft.WindowsTerminal",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "homepage": "https://learn.microsoft.com/windows/terminal/",
          "installedAppx": [
            "Microsoft.WindowsTerminal"
          ]
        },
        {
          "id": "powershell7",
          "name": "PowerShell 7",
          "description": "Modern cross-platform PowerShell",
          "provider": "winget",
          "package": "Microsoft.PowerShell",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "verify": "pwsh --version",
          "homepage": "https://learn.microsoft.com/powershell/",
          "installedNames": [
            "PowerShell 7-x64",
            "PowerShell 7 (x64)",
            "PowerShell 7"
