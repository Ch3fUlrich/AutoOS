{
  "$schema": "./schema.json",
  "platform": "macos",
  "profiles": {
    "workstation": "Full desktop workstation - the same coding and AI stack as the other platforms.",
    "ai-coding": "Coding and AI tooling plus the shell, no GUI extras.",
    "light": "Minimal remote-access box - Claude Code, Tailscale and Herdr only.",
    "rescue": "Disaster-recovery toolkit — disk, filesystem, hardware and Windows repair.",
    "local-ai": "Local AI inference with Ollama — no API key and no network, but models are 1.4-4.7 GB.",
    "custom": "Start with nothing ticked and choose by hand.",
    "everyday": "Everyday desktop: browsing, media, games, remote control and 3D printing."
  },
  "categories": [
    {
      "id": "core",
      "name": "Core CLI",
      "components": [
        {
          "id": "git",
          "name": "Git",
          "description": "Version control",
          "provider": "brew",
          "package": "git",
          "verify": "git --version",
          "profiles": [
            "workstation",
            "ai-coding",
            "light"
          ],
          "homepage": "https://git-scm.com/"
        },
        {
          "id": "download-tools",
          "name": "curl & wget",
          "description": "Download tools",
          "provider": "brew",
          "package": "curl wget",
          "verify": "curl --version",
          "profiles": [
            "workstation",
            "ai-coding",
            "light"
          ],
          "homepage": "https://curl.se/"
        },
        {
          "id": "monitoring",
          "name": "Monitoring tools",
          "description": "htop and fastfetch",
          "provider": "brew",
          "package": "htop fastfetch",
          "verify": "htop --version",
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "homepage": "https://github.com/fastfetch-cli/fastfetch"
        },
        {
          "id": "tmux",
          "name": "tmux",
          "description": "Terminal multiplexer",
          "provider": "brew",
          "package": "tmux",
          "verify": "tmux -V",
          "profiles": [
            "workstation",
            "ai-coding",
            "light"
          ],
          "homepage": "https://github.com/tmux/tmux/wiki"
        }
      ]
    },
    {
