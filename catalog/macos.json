          "provider": "custom",
          "package": "qwen3:1.7b",
          "postInstall": "pull_ollama_model_qwen3_1_7b",
          "requires": [
            "ollama"
          ],
          "verify": "ollama show qwen3:1.7b",
          "homepage": "https://ollama.com/library/qwen3",
          "profiles": []
        },
        {
          "id": "ollama-model-qwen2-5-coder-7b",
          "name": "Qwen2.5 Coder 7B",
