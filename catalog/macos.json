          "provider": "custom",
          "package": "qwen2.5-coder:7b",
          "postInstall": "pull_ollama_model_qwen25_coder_7b",
          "requires": [
            "ollama"
          ],
          "verify": "ollama show qwen2.5-coder:7b",
          "homepage": "https://ollama.com/library/qwen2.5-coder",
          "profiles": []
