            "git",
            "download-tools"
          ],
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "homepage": "https://ohmyz.sh/"
        },
        {
          "id": "zsh-plugins",
          "name": "Zsh plugins",
          "description": "autosuggestions and syntax highlighting",
          "provider": "script",
          "package": "zsh-plugins",
          "requires": [
            "oh-my-zsh"
          ],
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "homepage": "https://github.com/zsh-users/zsh-autosuggestions"
        },
        {
          "id": "powerlevel10k",
          "name": "Powerlevel10k",
          "description": "Prompt theme",
          "provider": "script",
          "package": "powerlevel10k",
          "requires": [
            "oh-my-zsh"
          ],
          "profiles": [
            "workstation",
            "ai-coding"
          ],
          "homepage": "https://github.com/romkatv/powerlevel10k"
        },
        {
          "id": "nerd-font",
          "name": "MesloLGS Nerd Font",
