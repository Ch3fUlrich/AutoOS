  "prompts": {
    "omnigraph_url": {
      "question": "Omnigraph remote server URL (blank = local Docker stack on :8080)",
      "default": "",
      "help": "If you run a shared Omnigraph server, give its base URL here and the MCP config will point at it instead of localhost."
    },
    "herdr_source": {
      "question": "Herdr install source",
      "default": "npm:herdr",
      "help": "Accepts npm:<package>, git:<url> or a direct download URL. Herdr is not in Homebrew, so AutoOS needs to be told where it lives."
    },
    "context7_api_key": {
      "question": "Upstash Context7 API key (blank to use default rate limit)",
      "default": "",
      "help": "Optional API key for Upstash Context7 live documentation lookups."
    }
  }
