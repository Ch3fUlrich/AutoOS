          "provider": "brew",
          "package": "font-meslo-lg-nerd-font",
          "cask": true,
          "profiles": [
            "workstation"
          ],
          "homepage": "https://www.nerdfonts.com/"
        }
      ]
    },
    {
      "id": "ai-coding",
      "name": "Coding & AI",
      "components": [
        {
          "id": "nodejs",
          "name": "Node.js LTS",
          "description": "Runtime required by Claude Code",
          "provider": "brew",
          "package": "node",
          "verify": "node --version",
          "profiles": [
            "workstation",
            "ai-coding",
            "light"
          ],
          "homepage": "https://nodejs.org/"
        },
        {
          "id": "claude-code",
          "name": "Claude Code CLI",
          "description": "Anthropic's terminal coding agent",
          "provider": "npm",
          "package": "@anthropic-ai/claude-code",
          "verify": "claude --version",
          "requires": [
            "nodejs"
          ],
          "profiles": [
            "workstation",
            "ai-coding",
            "light",
            "rescue"
          ],
          "homepage": "https://docs.anthropic.com/en/docs/claude-code"
        },
        {
          "id": "agy",
          "name": "Antigravity CLI",
          "description": "Google's terminal coding agent",
          "provider": "script",
          "package": "agy",
          "verify": "agy --version",
          "requires": [
            "download-tools"
          ],
          "profiles": [
            "workstation",
            "ai-coding",
            "light",
            "rescue"
          ],
          "homepage": "https://antigravity.google/product/antigravity-cli",
          "notes": "Replaces Gemini CLI. Headless use (agy -p) needs a prior interactive login on this machine — not possible on an offline box that has never run agy before."
        },
        {
          "id": "qwen-code",
          "name": "Qwen Code CLI",
          "description": "Qwen's terminal coding agent (routable through OmniRoute)",
          "provider": "npm",
          "package": "@qwen-code/qwen-code",
          "requires": [
            "nodejs"
          ],
          "profiles": [
            "ai-coding"
          ],
          "verify": "qwen --version",
          "homepage": "https://github.com/QwenLM/qwen-code",
          "notes": "Headless: qwen -p. tools/autoos-agent.py --client qwen routes it through OmniRoute."
        },
        {
          "id": "gemini-cli",
          "name": "Gemini CLI",
          "description": "Google's open-source terminal agent (OmniRoute-routable)",
          "provider": "npm",
          "package": "@google/gemini-cli",
          "requires": [
            "nodejs"
          ],
          "profiles": [
            "ai-coding"
          ],
          "verify": "gemini --version",
          "homepage": "https://github.com/google-gemini/gemini-cli",
          "notes": "Headless: gemini -p. agy succeeds it, but only this one can route through OmniRoute."
        },
        {
          "id": "codex",
          "name": "OpenAI Codex CLI",
          "description": "OpenAI's terminal coding agent (OmniRoute-routable)",
          "provider": "npm",
          "package": "@openai/codex",
          "requires": [
            "nodejs"
          ],
          "profiles": [
            "ai-coding"
          ],
          "verify": "codex --version",
          "homepage": "https://github.com/openai/codex",
          "notes": "Headless: codex exec. Spawned through omniroute run, so no OpenAI login is needed."
        },
        {
          "id": "qodercli",
          "name": "Qoder CLI",
          "description": "Qoder's terminal coding agent (own account, not the gateway)",
          "provider": "npm",
          "package": "@qoder-ai/qodercli",
          "requires": [
            "nodejs"
          ],
          "profiles": [
            "ai-coding"
          ],
          "verify": "qodercli --version",
          "homepage": "https://qoder.com/cli",
          "notes": "Headless: qodercli -p. Auth: QODER_PERSONAL_ACCESS_TOKEN or one interactive qodercli login."
        },
        {
          "id": "ollama",
          "name": "Ollama",
          "description": "Local AI model runtime",
          "provider": "brew",
          "package": "ollama",
          "verify": "ollama --version",
          "homepage": "https://ollama.com/",
          "profiles": [
            "local-ai"
          ]
        },
        {
          "id": "ollama-model-qwen3-4b",
          "name": "Qwen3 4B",
          "description": "General-purpose local model, 2.5 GB download, 256K context",
          "provider": "custom",
          "package": "qwen3:4b",
          "postInstall": "pull_ollama_model_qwen3_4b",
          "requires": [
            "ollama"
          ],
          "verify": "ollama show qwen3:4b",
          "homepage": "https://ollama.com/library/qwen3",
          "notes": "Pre-ticked default: small enough to load fast off USB, and its 256K context fits a full dmesg/SMART dump.",
          "profiles": [
            "local-ai"
          ]
        },
        {
          "id": "ollama-model-qwen3-1-7b",
          "name": "Qwen3 1.7B",
