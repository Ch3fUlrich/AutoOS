{
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "model": "anthropic/claude-sonnet-4",
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["uvx", "serena-agent"]
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "npm *": "ask",
      "git push*": "allow",
      "git merge*": "allow"
    }
  },
  "instructions": [
    "my-rules.md"
  ],
  "agent": {
    "build": {
      "model": "x/y"
    }
  }
}
