# Refresh the daily cost-gate verdict from the gateway call log.
# Driven by the timer next to this file; it has no [Install] section of its own,
# so `systemctl --user enable` always targets the timer, never this unit.
#
# Oneshot on purpose: the refresh either succeeds (the gate file is rewritten
# atomically) or exits non-zero with the previous gate file still in place, and
# a 10-minute timer must not pile up overlapping refreshes.
#
# ExecStart is rendered by install_cost_gate with the repository root the
# installer was run from (@APPROOT@): the refresh script and the price data it
# reads live in the checkout, so the unit names that root directly. A checkout
# that is moved must be reinstalled, and a removed one must fail loudly here
# rather than run some other copy from a fixed home-relative path.
#
# StandardOutput/StandardError: without these the refresh's one explanatory
# line never reaches the journal, and `journalctl --user -u cost-gate` - the
# command the troubleshooting docs tell you to run - shows nothing at all.
[Unit]
Description=Refresh the daily cost-gate verdict from the gateway call log
Documentation=file://@APPROOT@/docs/ai/cost-guard.md

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 @APPROOT@/tools/cost-gate-refresh.py --gateway
StandardOutput=journal
StandardError=journal
