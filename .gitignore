# CodeWhale local session data
.codewhale/

# Serena per-project data (auto-generated, not tracked)
# Serena: the CURATED config is durable project knowledge and must be TRACKED -- a linked
# worktree that does not receive it makes Serena autogenerate one, and autogeneration picks
# languages by file count, which reintroduces json/markdown/yaml every single time. Note the
# pattern must be `.serena/*`, not `.serena/`: a negation cannot re-include a file inside a
# directory git has already excluded. cache/, logs/ and memories/ stay out.
.serena/*
!.serena/project.yml
!starters/mcp-servers/.serena/

# Graphify data (generated — regenerable, never track)
graphify-out/

# Playwright MCP output (snapshots, console logs, screenshots from UI verification)
.playwright-mcp/

# MCP server data (persistent, machine-local)
mcp-servers/data/
infra/mcp-servers/data/

# Omnigraph + MinIO local runtime data
**/omnigraph-data/
**/minio-data/

# Node.js dependencies (generated)
mcp-servers/servers/superpowers/node_modules/
mcp-servers/servers/superpowers/package-lock.json
mcp-servers/servers/superpowers/pnpm-lock.yaml
mcp-servers/servers/superpowers/.git/
mcp-servers/servers/superpowers/.github/
mcp-servers/servers/superpowers/.gitignore
mcp-servers/servers/superpowers/tsconfig.json



# Generated JS source maps (reproducible from TypeScript)
mcp-servers/superpowers/build/*.map

# Test files (not needed at runtime)
mcp-servers/superpowers/src/prompts/register.test.ts
mcp-servers/superpowers/src/resources/register.test.ts
mcp-servers/superpowers/src/skills/discovery.test.ts
mcp-servers/superpowers/src/skills/types.test.ts
mcp-servers/superpowers/src/tools/intelligence.test.ts
mcp-servers/superpowers/src/tools/register.test.ts
mcp-servers/superpowers/src/config.test.ts
mcp-servers/superpowers/src/git.test.ts
mcp-servers/superpowers/src/integration.test.ts
mcp-servers/superpowers/src/server.test.ts
mcp-servers/superpowers/src/update.test.ts

# test results
**/.agent-state/
**/mock_test_dir/

# Local graph backups (NDJSON exports + MinIO byte copies) — never track.
# Unanchored on purpose: the writers build this path relative to their CWD
# (apply-cluster.sh cds to infra/mcp-servers first, others do not), so a run
# from the repo root drops the same dumps at the root. Pinning the rule to one
# location let 132K of graph exports show up as untracked and inviting a commit.
.graph-backup/

# secrets
agent_keys.yaml

# API keys for orchestration providers (DeepSeek, etc). The SHAPE is tracked
# (secrets/api_keys.conf.example), the CONTENTS never are. Anchored to the repo
# root because that is the only place the loader looks; the negation keeps the
# example visible even though the glob above would otherwise swallow it.
/secrets/*
!/secrets/api_keys.conf.example
!/secrets/.gitignore
!/secrets/README.md

# Claude Code: local per-machine settings (MCP approvals) never get committed.
# Tracked .claude/ artifacts (agents, workflows, hooks) are added when ADR 0004 lands.
.claude/settings.local.json

# Omnigraph cluster: the SHAPE is tracked (cluster.yaml.example), the CONTENTS are not.
# Graphs are named after the repos they serve, so the live file is a list of every
# project you work on — and add-project-graph.sh appends to it automatically. This
# repo is public. Copy the example to cluster.yaml on first setup.
infra/mcp-servers/cluster/cluster.yaml

# Omnigraph seeds for OTHER repos' graphs. agent-skills.jsonl and memory.jsonl stay
# tracked (this repo's own graph + global Preferences). A seed is a full export of a
# project's memory — its module map, decisions and infrastructure — so publishing
# another repo's seed here publishes that repo. Keep them on disk (the boot seeder
# and the documented recovery path both read them); just never commit them.
infra/mcp-servers/cluster/seed/*.jsonl
!infra/mcp-servers/cluster/seed/agent-skills.jsonl
!infra/mcp-servers/cluster/seed/memory.jsonl

# Homelab site config — hosts/users/addresses. The real file lives outside the
# repo (~/.config/homelab/homelab.yaml); this is defence in depth so a copy
# dropped in-tree can never be committed. Only the .example is tracked.
homelab.yaml
**/homelab.yaml
!**/homelab.example.yaml

# A Windows absolute path written literally by a tool that expected POSIX
# (Serena's SERENA_HOME is a C:/... path; under WSL it becomes a RELATIVE
# directory here). 1926 junk files nearly reached a commit this way, so the
# shape is ignored rather than the one name: WSL encodes ':' as U+F03A, and
# a plain-ASCII 'C:' appears under other shells.
/C/
/[A-Za-z]:/

# CAO lane run state. `--state-dir` defaults to output/cao and holds NDJSON
# ledgers with verdicts, quota records and captured agent output; leases are
# per-run locks. Neither belongs in a commit, and both appear untracked in the
# repo root where a `git add -A` sweeps them up.
/output/cao/
/.cao-leases/
