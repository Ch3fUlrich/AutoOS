# Template for ~/.config/autoos/ai-stack/stack.env - ai-stack.sh init writes
# the real file (mode 600) and only ever ADDS missing keys, so a value you
# edit there stays yours. Non-secret settings only: secrets live in
# opencode.env / openhands.env next to it, OmniRoute's in its own data dir.

# Host user the gateway and opencode run as (owner of the data dirs).
AUTOOS_UID=1000
AUTOOS_GID=1000
# The code tree, mounted at the SAME path in opencode and in every OpenHands
# sandbox. ai-stack.sh init fills in this machine's path.
AUTOOS_CODE_DIR=
# Where the containers keep state (ai-stack.sh init fills these in).
AUTOOS_STACK_DATA=
AUTOOS_STACK_CONFIG=
AUTOOS_OPENHANDS_DIR=
# Publish address for 20128/4096/3000. 0.0.0.0 because host CLIs use
# 127.0.0.1, sandboxes use the docker gateway and the LAN proxy the LAN IP;
# the host firewall (DOCKER-USER) limits LAN access to the proxy.
# ai-stack.sh up/migrate refuse a non-loopback address unless the firewall
# unit coding-agents-fw.service is active, or you accept the exposure here:
AUTOOS_STACK_BIND=0.0.0.0
# AUTOOS_STACK_ALLOW_LAN=1
# The opencode-auth forwarder (:4097) is opt-in: it injects opencode's Basic
# auth for a reverse proxy that forwards to it instead of :4096. ai-stack.sh
# refuses it on a non-loopback bind until coding-agents-fw.service actually
# restricts :4097 (AUTOOS_STACK_ALLOW_LAN=1 overrides that too).
# COMPOSE_PROFILES=edge-forwarder
# The gateway's public origin, for the redirect URIs and links it builds on the server
# (docs/web-services.md, "OAuth logins and the public URL"). Unset or empty = off.
# AUTOOS_OMNIROUTE_PUBLIC_URL=https://<your-omniroute-host>
# RAM budget (docs/web-services.md, Server profile): V8 heap, then the container ceiling.
OMNIROUTE_MEMORY_MB=1536
# Parallel heavy chat requests the gateway admits (image default 1 rejects agent workers; measured 2026-09-27).
# OMNIROUTE_CHAT_MAX_HEAVY_IN_FLIGHT=6
# How long a queued heavy request waits before 503 in ms (image default 2000 rejects agent workers).
# OMNIROUTE_CHAT_ADMISSION_QUEUE_MS=60000
# Per-call log artifacts (measured 2026-09-27: 831 MB in 3905 files in one day):
# page cache counts toward the gateway's pressure guard (503 above 92% cgroup
# use), so the logs are capped: body KB per call (image default 1024), text
# chars kept per call (image default 65536), days of call logs kept (image default 7).
# CHAT_LOG_MAX_BODY_KB=64
# CHAT_LOG_TEXT_LIMIT=16384
# CALL_LOG_RETENTION_DAYS=3
OMNIROUTE_MEM_LIMIT=2560m
OPENCODE_MEM_LIMIT=1536m
AUTOOS_OPENHANDS_MEMORY=2g
