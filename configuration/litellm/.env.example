# Copy to configuration/litellm/.env (git-ignored, never committed) and fill in.
# How to get each key: docs/api-keys.md
# Free, no card: GROQ, CEREBRAS, GEMINI (AI Studio), MISTRAL, META ($20 starter).
# Paid: ZEN ($20 prepaid), OPENROUTER (top up as needed), DEEPSEEK (cheap direct).

GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY
CEREBRAS_API_KEY=REPLACE_WITH_YOUR_CEREBRAS_KEY
GEMINI_API_KEY=REPLACE_WITH_YOUR_GOOGLE_AI_STUDIO_KEY
MISTRAL_API_KEY=REPLACE_WITH_YOUR_MISTRAL_KEY
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
META_API_KEY=REPLACE_WITH_YOUR_META_MODEL_API_KEY
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_KEY
OPENCODE_ZEN_API_KEY=REPLACE_WITH_YOUR_ZEN_KEY
LITELLM_MASTER_KEY=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
