# Herdr agent multiplexer, started at boot for a login user.
#
# WHY A UNIT AND NOT A LOGIN SHELL: before this existed, herdr only came up when
# somebody SSH'd in -- so every reboot silently ended the session, and nothing
# could restore automatically, because the thing that owns the panes was not
# running.
#
# WHY IT MATTERS THAT SYSTEMD STARTS IT, NOT A CLAUDE SESSION: a herdr server
# inherits the environment of whatever launched it and hands that to every pane
# it spawns. Started from inside a Claude session it inherits CLAUDE_CODE_*,
# which makes every claude in every pane believe it is a CHILD session and
# silently DISABLES TRANSCRIPT SAVING — the sessions then cannot be resumed at
# all. The user manager's environment is clean, so this unit cannot reintroduce
# that bug.
#
# WHY THE `already running` GUARD: herdr refuses to start a second instance and
# exits 1. Without the guard, starting this unit while a manually-launched herdr
# is up puts it in an endless Restart=on-failure loop. The unit's job is "a
# herdr server is running", which is already satisfied in that case, so it
# reports success and supervises nothing.
#
# Requires lingering so it starts at boot without a login:
#   sudo loginctl enable-linger <user>
# Install: see ../../install.sh --profile <yours>
[Unit]
Description=Herdr agent multiplexer (headless, user session)
Documentation="file://@APPDIR@/README.md"
# The update unit runs first so a fresh herdr/claude binary is what this server
# and every pane it spawns pick up. Wants= (not Requires=): a failed or skipped
# update must never keep the session from coming back.
After=network-online.target herdr-sessions-update.service
Wants=network-online.target herdr-sessions-update.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# A pane process killed by the kernel OOM killer must not take this whole
# unit (and every other pane) down with it; systemd's default OOMPolicy=stop
# did exactly that, twice.
OOMPolicy=continue
Environment=SHELL=/bin/zsh
# claude, herdr and uv/uvx (serena, graphify) all live in %h/.local/bin, and
# panes inherit this manager environment rather than an interactive .zshrc.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# @HERDR_BIN@ is rendered by install.sh from the profile's HERDR_BIN
# (default %h/.local/bin/herdr): the same binary the driver runs. It arrives as
# ONE quoted argument placed AFTER the script (so the shell never has to parse
# it, and `sh -c` binds it to $1), because a path escaped twice -- once for
# systemd, once for the shell -- is a path whose `%` systemd reads as a
# specifier and whose `\` it reads as noise.
ExecStart=/bin/sh -c 'if "$1" status 2>/dev/null | grep -q "status: running"; then echo "herdr server already running — nothing to do"; exit 0; fi; exec "$1" server' _ @HERDR_BIN@
Restart=on-failure
RestartSec=10
# The guard above exits 0 when a server is already up; RemainAfterExit keeps the
# unit active in that case (and if the binary daemonises itself) rather than flap.
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
