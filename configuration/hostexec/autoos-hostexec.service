[Unit]
Description=AutoOS hostexec broker (deny-list + audit boundary for agent shell access)
Documentation=file:<repo>/configuration/hostexec/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 <repo>/tools/hostexec.py serve --policy %h/.config/autoos/exec/policy.toml
EnvironmentFile=-%h/.config/autoos/exec/hostexec.env
Restart=on-failure
OOMPolicy=continue
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
